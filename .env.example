# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# next-auth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Mejlovi (Gmail API)
# Osnovni URL aplikacije — koristi se za OAuth redirect URI
# (lokalno: http://localhost:3000)
APP_URL=
# Ključ za šifrovanje Gmail refresh tokena: openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=
# Tajna kojom se štiti /api/emails/process (cron): openssl rand -hex 32
CRON_SECRET=
